# Keep the real token outside this repository, for example in your Windows user environment.
APPETIZE_API_TOKEN=

# Required before uploads because an Appetize build link is shareable by anyone who has it.
APPETIZE_ALLOW_PUBLIC_PREVIEW=0

# A controlled local folder containing only GitHub-downloaded simulator artifacts.
IOS_PREVIEW_ARTIFACT_DIR=C:\\Users\\alial\\dev\\LidlLean\\preview-artifacts

# Set to 1 when you want to watch the local Playwright bridge browser for debugging.
IOS_PREVIEW_HEADED=0
